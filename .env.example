# 실제 값은 .env.local에만 적는다 (커밋 금지, .gitignore가 이미 제외).
# 이 파일은 플레이스홀더만 담아 추적한다 — 새 환경 변수를 추가하면 여기도 같이 갱신한다.
# 변수 정의: docs/Architecture.md "배포 > 환경별 설정", ADR-0004(설정 저장), ADR-0008(전화번호 암호화)

# Supabase — 프로젝트의 Connect / API Keys 화면에서 확인 (T-02)
# 공개 키: anon 또는 publishable 키. 변수명은 팀 설계와 호환되도록 유지한다.
# 브라우저에 노출됨. 이 키에는 테이블 정책을 주지 않는다 (ADR-0001: 모든 데이터 접근은 Route Handler 경유)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 서버 전용 — service_role 또는 secret 키. 공개 키 입력란에 넣지 않는다.
# 절대 클라이언트 코드에서 import 금지, 절대 커밋 금지
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 관리자 화면 맨 위 "비상 시 학회장에게 전화" 번호(서버 전용). 공개 저장소라 실제 번호는 여기 적지 않고
# 운영은 Cloudflare Workers 변수, 로컬은 .env.local에만 넣는다. 비워 두면 비상 연락 줄이 보이지 않는다.
EMERGENCY_CONTACT_PHONE=

# 2차(T-49) 전화번호 암호화 키 — 도입 전까지는 비워 둔다 (ADR-0008)
# PHONE_ENCRYPTION_KEY=

# 계좌 정보(은행명·계좌번호·예금주)는 환경변수가 아니다 — app_settings에서 관리
# 관리자 화면(T-52)으로 입력한다 (ADR-0004, F-44)
