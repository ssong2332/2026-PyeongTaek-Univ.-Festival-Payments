# 실제 값은 .env.local에만 적는다 (커밋 금지, .gitignore가 이미 제외).
# 이 파일은 플레이스홀더만 담아 추적한다 — 새 환경 변수를 추가하면 여기도 같이 갱신한다.
# 변수 정의: docs/Architecture.md "배포 > 환경별 설정", ADR-0004(설정 저장), ADR-0008(전화번호 암호화)

# Supabase — 프로젝트 설정 > API 에서 확인 (T-02)
# 브라우저에 노출됨. 이 키에는 테이블 정책을 주지 않는다 (ADR-0001: 모든 데이터 접근은 Route Handler 경유)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 서버 전용 — 절대 클라이언트 코드에서 import 금지, 절대 커밋 금지
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 2차(T-49) 전화번호 암호화 키 — 도입 전까지는 비워 둔다 (ADR-0008)
# PHONE_ENCRYPTION_KEY=

# 계좌번호·카카오페이·토스 송금 링크는 환경변수가 아니다 —
# app_settings 테이블에서 관리자 화면(T-52)으로 입력한다 (ADR-0004, F-44)
