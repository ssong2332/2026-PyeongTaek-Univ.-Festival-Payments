{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "ptu-festival-payments",
    "main": ".open-next/worker.js",
    "compatibility_date": "2024-09-23",
    "compatibility_flags": [
        // Node.js API 사용(OpenNext 필수, compatibility_date 2024-09-23 이상)
        "nodejs_compat",
        // 앱 안에서 공개 URL(Supabase API 등) fetch 허용 — OpenNext 권장 설정
        "global_fetch_strictly_public"
    ],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    // OpenNext 권장 설정: service는 위 "name"과 같아야 한다
    "services": [
        {
            "binding": "WORKER_SELF_REFERENCE",
            "service": "ptu-festival-payments"
        }
    ],
    // Workers Logs: 대시보드에 저장하지 않는다 — 상태 토큰이 든 URL이 저장 로그에 남지 않게(PR #91 리뷰, 팀장 결정 2026-10-04).
    // 실시간 로그(`npx wrangler tail`)는 이 저장 설정과 별개로 저장 없이 본다(Cloudflare 문서 "Real-time logs").
    // 대시보드 값과 같게 둔다 — 설정 파일에 없으면 배포가 대시보드 값과 어긋날 수 있다
    // (Cloudflare 대시보드 안내 "Update your Wrangler configuration … to keep deployments in sync").
    "observability": {
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            // 끈다: invocation log는 요청 URL을 남기므로 /orders/{token}·/api/orders/{token}의 상태 토큰이 기록된다.
            "invocation_logs": false,
            // 끈다: invocation log를 꺼도 Cloudflare가 앱 console 로그마다 요청 URL·경로($workers.event.request.url/path,
            // $metadata.trigger)를 붙인다(2026-10-04 운영에서 확인). 로그 본문(src/lib/logger.ts)에는 토큰이 없어도
            // 저장 로그에 토큰이 남으므로 대시보드 저장 자체를 끈다. redact_query_string은 query string만 지워 대안이 아니다.
            "persist": false
        },
        "traces": {
            "enabled": false,
            "head_sampling_rate": 1,
            "persist": true
        },
        // 대시보드 예시의 "issue_detection"은 고정된 wrangler 4.145.0 스키마에 없다 — 같은 설정의 키 이름은 "issues"
        "issues": {
            "enabled": false
        }
    },
    // Cloudflare Workers Free (100,000 req/day, 10ms CPU/req)
    // Production Branch: main (DECISIONS #53 — dev → main PR 병합 시 배포)
    // 운영 URL 형식: https://ptu-festival-payments.<계정 workers.dev 서브도메인>.workers.dev
    //   계정 서브도메인은 Cloudflare 대시보드 Workers & Pages의 "Your subdomain"에서 확인한다(docs/T-25-deployment.md).
    "vars": {
        // 비시크릿 환경변수는 Cloudflare 대시보드에서 설정한다.
        // NEXT_PUBLIC_* 는 빌드할 때 브라우저 코드에 들어가므로 "빌드 변수"에도 등록해야 한다(docs/T-25-deployment.md 3절).
        // 시크릿(SUPABASE_SERVICE_ROLE_KEY)은 대시보드 Secret 또는 wrangler secret put으로만 등록한다.
    }
}
