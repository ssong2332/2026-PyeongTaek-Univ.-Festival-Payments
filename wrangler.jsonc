{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "ptu-festival-payments",
    "main": ".open-next/worker.js",
    "compatibility_date": "2024-09-23",
    "compatibility_flags": [
        // Node.js API 사용(OpenNext 필수, compatibility_date 2024-09-23 이상)
        "nodejs_compat",
        // 앱 안에서 공개 URL(Supabase API 등) fetch 허용 — OpenNext 권장 설정
        "global_fetch_strictly_public"
    ],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    // OpenNext 권장 설정: service는 위 "name"과 같아야 한다
    "services": [
        {
            "binding": "WORKER_SELF_REFERENCE",
            "service": "ptu-festival-payments"
        }
    ],
    // Workers Logs: 운영 중 오류 원인 확인용(Free 200,000건/일·3일 보관). 대시보드 값과 같게 둔다 —
    // 설정 파일에 없으면 배포가 대시보드 값과 어긋날 수 있다(Cloudflare 대시보드 안내 "Update your Wrangler configuration … to keep deployments in sync").
    "observability": {
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            // 끈다: invocation log는 요청 경로를 저장하므로 /orders/{token}·/api/orders/{token}의 상태 토큰이 로그에 남는다.
            // 앱 로그(src/lib/logger.ts)는 허용 필드만 남기고 route는 "/api/orders/[token]" 형식이라 토큰이 없다.
            // redact_query_string은 query string만 지워서 경로의 토큰은 막지 못한다(PR #91 리뷰).
            "invocation_logs": false,
            "persist": true
        },
        "traces": {
            "enabled": false,
            "head_sampling_rate": 1,
            "persist": true
        },
        // 대시보드 예시의 "issue_detection"은 고정된 wrangler 4.145.0 스키마에 없다 — 같은 설정의 키 이름은 "issues"
        "issues": {
            "enabled": false
        }
    },
    // Cloudflare Workers Free (100,000 req/day, 10ms CPU/req)
    // Production Branch: main (DECISIONS #53 — dev → main PR 병합 시 배포)
    // 운영 URL 형식: https://ptu-festival-payments.<계정 workers.dev 서브도메인>.workers.dev
    //   계정 서브도메인은 Cloudflare 대시보드 Workers & Pages의 "Your subdomain"에서 확인한다(docs/T-25-deployment.md).
    "vars": {
        // 비시크릿 환경변수는 Cloudflare 대시보드에서 설정한다.
        // NEXT_PUBLIC_* 는 빌드할 때 브라우저 코드에 들어가므로 "빌드 변수"에도 등록해야 한다(docs/T-25-deployment.md 3절).
        // 시크릿(SUPABASE_SERVICE_ROLE_KEY)은 대시보드 Secret 또는 wrangler secret put으로만 등록한다.
    }
}
